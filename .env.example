# ============================================
# JOJO 替身生成器 - 本地开发环境变量
# ============================================
# 复制此文件为 .env 并填入你自己的 API Key
# cp .env.example .env
#
# 注意：.env 文件已在 .gitignore 中，不会被提交到仓库
# 注意：VITE_ 前缀的变量会暴露在前端代码中，仅用于本地开发

# [必填] 文本生成 API Key
VITE_TEXT_API_KEY=your_text_api_key_here

# [可选] 文本生成接口地址
VITE_TEXT_BASE_URL=https://api.bltcy.ai/

# [可选] 文本生成模型
VITE_TEXT_MODEL=gemini-3-flash-preview

# [可选] 图片生成独立配置；不配置 VITE_IMAGE_API_KEY 时会复用文本 Key
VITE_IMAGE_API_KEY=your_image_api_key_here
VITE_IMAGE_BASE_URL=https://api.bltcy.ai/
VITE_IMAGE_MODEL=gpt-image-2

# [可选] 生图超时时间
VITE_IMAGE_TIMEOUT_MS=240000

# 兼容说明：
# 旧变量 VITE_GEMINI_API_KEY / VITE_GEMINI_BASE_URL / VITE_GEMINI_MODEL 仍可作为 fallback 使用。
