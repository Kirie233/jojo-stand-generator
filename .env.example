# ============================================
# JOJO 替身生成器 - 本地开发环境变量
# ============================================
# 复制此文件为 .env 并填入你自己的 API Key
# cp .env.example .env
#
# ⚠️ 注意：.env 文件已在 .gitignore 中，不会被提交到仓库
# ⚠️ VITE_ 前缀的变量会暴露在前端代码中，仅用于本地开发！

# [必填] Gemini API Key (用于文本生成)
VITE_GEMINI_API_KEY=your_api_key_here

# [可选] 自定义 API 地址 (如果你使用中转/代理服务)
# VITE_GEMINI_BASE_URL=https://api.bltcy.ai/

# [可选] 文本生成模型
# VITE_GEMINI_MODEL=gemini-3-flash-preview

# [可选] 图片生成独立配置 (如不配置，将复用上面的 GEMINI 配置)
# VITE_IMAGE_API_KEY=your_image_api_key_here
# VITE_IMAGE_BASE_URL=https://api.bltcy.ai/
# VITE_IMAGE_MODEL=gpt-image-2

# --- gpt-image-2 配置示例 ---
# 使用 gpt-image-2 时，设置以下变量：
# VITE_IMAGE_API_KEY=sk-your-openai-key
# VITE_IMAGE_BASE_URL=https://api.openai.com
# VITE_IMAGE_MODEL=gpt-image-2
# VITE_IMAGE_QUALITY=high          # low / medium / high (默认 high)
# VITE_IMAGE_SIZE=1024x1024        # 1024x1024 / 1536x1024 / 1024x1536 / auto

# --- Gemini 生图配置示例 ---
# 如需继续使用 Gemini 生图，可改为：
# VITE_IMAGE_MODEL=gemini
# 或
# VITE_IMAGE_MODEL=gemini-3-pro-image-preview
